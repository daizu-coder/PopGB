#include <windows.h>
#include "ce_resource.h"

/* App icon (16x16 + 32x32, 32bpp). IDI_MAIN is this file's lowest-numbered
 * (and only) ICON resource, so it is the one the shell shows for
 * AppMain.exe; ce_main.c's RegisterClassW also loads it via
 * LoadIconW(IDI_MAIN). Kept next to the mascot in sys/ce/icon/. */
IDI_MAIN ICON "icon/popgb.ico"

/* Touch-to-reveal main menu - see ce_resource.h for why this is a plain
 * DialogBoxW instead of a real HMENU. English captions only in this
 * .rc (same as the sister ports' shared ce_res.rc: Japanese text is
 * kept to \x-escaped UTF-16 C string literals instead, not verified
 * to survive the windres pipeline). Layout ported unchanged from
 * the sister ports' shared IDD_MAINMENU (same 210x140 rects). */
/* Every PUSHBUTTON carries BS_OWNERDRAW - see ce_bmpfont.c. The label
 * text drawn by MainMenuDlgProc's WM_DRAWITEM comes from the button's
 * own GetWindowTextW(), which ApplyMainMenuLanguage() still sets via
 * SetDlgItemTextW() exactly as before; only the paint path changed, not
 * how the text gets there. IDC_MM_HINT stays a plain LTEXT - it's
 * hidden (ShowWindow SW_HIDE) by ApplyMainMenuLanguage() and repainted
 * by WM_PAINT via CeBmpFontPaintLabel() instead. */
/* Pastel/rounded skin ported from the sister PopSG (its IDD_MAINMENU
 * after the on-device-confirmed redesign rounds): same-row gap 8px, the
 * Video/Sound/Input row 34 tall for an icon-over-label layout, a
 * Screenshot | Exit bottom row, and the dialog grown 140->154. Colors,
 * RoundRect() drawing and the mascot blit live in ce_main.c's
 * MainMenuDlgProc (kMainMenuTheme, WM_ERASEBKGND, WM_PAINT). */
IDD_MAINMENU DIALOG 0, 0, 210, 154
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PopGB"
FONT 9, "Tahoma"
BEGIN
    PUSHBUTTON "Open ROM...", IDC_MM_OPEN,       8,  8, 194, 20, WS_GROUP | WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "Save State",  IDC_MM_SAVESTATE,  8, 32,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Load State",  IDC_MM_LOADSTATE, 109, 32,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Video Cfg",   IDC_MM_VIDEO,      8, 56,  59, 34, BS_OWNERDRAW
    PUSHBUTTON "Sound Cfg",   IDC_MM_SOUND,     75, 56,  60, 34, BS_OWNERDRAW
    PUSHBUTTON "Input Cfg",   IDC_MM_INPUT,    143, 56,  59, 34, BS_OWNERDRAW
    PUSHBUTTON "Screenshot",  IDC_MM_SCREENSHOT, 8, 94,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Exit",        IDC_MM_EXIT,     109, 94,  93, 20, BS_OWNERDRAW
    LTEXT "Press Back to resume the game.", IDC_MM_HINT, 8, 122, 194, 20
END

IDB_MAINMENU BITMAP "icon/popgb_mascot.bmp"

/* Two-column grid, sized for gnuboy's own content rather than copied
 * from the sister PopNES project's dimensions (an earlier pass
 * here matched PopNES's label/button/row-pitch byte-for-byte per a
 * prior user request, but that geometry was sized for PopNES's own
 * short NES-style labels - a later hardware round found gnuboy's own
 * labels/values didn't fit that borrowed sizing well, so this is a
 * ground-up redesign for gnuboy specifically, user request).
 *
 * Two content classes need more room than PopNES's 32/48 gave them:
 *   - the remap PUSHBUTTONs show a live key name from ce_input.c's
 *     VkToLabel()/kVkNames - "Backspace", "Function", "Previous" are all
 *     7-9 characters, and BeginWaitForKey() briefly shows the 13-
 *     character "Press a key..." while waiting for a new binding;
 *   - the Select/Start row labels switch to 4-character full-width
 *     Japanese ("\x30bb\x30ec\x30af\x30c8"/"\x30b9\x30bf\x30fc\x30c8",
 *     ApplyInputConfigLanguage() in ce_input.c) in MS Gothic, which
 *     needs more horizontal room per character than the Tahoma English
 *     text the old width was sized around.
 *
 * Every remap row uses the same label 40x12 / PUSHBUTTON 52x14 sizing
 * (an in-between pass here also tried splitting the four diagonal D-pad
 * combo rows - Up R/R Down/Down L/L Up, see ce_input.c's
 * CeInputMapEntry.idB - across both columns, but user feedback was that
 * they belong stacked under Left/Right in the left column instead, not
 * spread into the right column). Left column (8 rows): Up/Down/Left/
 * Right/Up R/R Down/Down L/L Up. Right column (4 rows, top only - this
 * port has no Turbo buttons to fill the bottom four with, so they're
 * simply left blank rather than stretched or padded): A/B/Select/Start.
 * label x=4 (left) / x=110 (right), PUSHBUTTON x=48 / x=154, 17 DLU row
 * pitch (y = 8, 25, 42, 59, 76, 93, 110, 127 for the button; label is 1
 * DLU lower). WS_GROUP on the first button makes Up/Down wrap through OK
 * and back, same mechanism as IDD_MAINMENU. No Cancel button - see
 * IDD_SOUNDCONFIG's comment on why. Dialog is 210x170 - width matches
 * IDD_MAINMENU (a safely hardware-verified width, see this section's own
 * header comment above), height back to fitting all 8 left-column rows
 * plus OK. */
/* Every PUSHBUTTON carries BS_OWNERDRAW - see ce_bmpfont.c. "A"/"B"/
 * "Up R"/"R Down"/"Down L"/"L Up" now have real IDs (IDC_IC_LBL_A etc.,
 * ce_resource.h) instead of "-1" so WM_PAINT's CeBmpFontPaintLabel()
 * can find them, even though they're never translated. */
IDD_INPUTCONFIG DIALOG 0, 0, 210, 170
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Input Config"
FONT 9, "Tahoma"
BEGIN
    /* 2026-09-27 (PopPCE と同じ変更): remap buttons widened to 54 - the
     * Galmuri14 font's "Press key"/"Backspace" overflowed 48 on real
     * hardware (PopPCE). The dialog width is unchanged; the gaps between
     * the columns and the right margin were narrowed instead. */
    LTEXT      "Up",     IDC_IC_LBL_UP,      4,   9, 40, 12
    PUSHBUTTON "",       IDC_IC_BTN_UP,     48,   8, 54, 14, WS_GROUP | WS_TABSTOP | BS_OWNERDRAW
    LTEXT      "A",      IDC_IC_LBL_A,     106,   9, 40, 12
    PUSHBUTTON "",       IDC_IC_BTN_A,     150,   8, 54, 14, BS_OWNERDRAW

    LTEXT      "Down",   IDC_IC_LBL_DOWN,    4,  26, 40, 12
    PUSHBUTTON "",       IDC_IC_BTN_DOWN,   48,  25, 54, 14, BS_OWNERDRAW
    LTEXT      "B",      IDC_IC_LBL_B,     106,  26, 40, 12
    PUSHBUTTON "",       IDC_IC_BTN_B,     150,  25, 54, 14, BS_OWNERDRAW

    LTEXT      "Left",   IDC_IC_LBL_LEFT,    4,  43, 40, 12
    PUSHBUTTON "",       IDC_IC_BTN_LEFT,   48,  42, 54, 14, BS_OWNERDRAW
    LTEXT      "Select", IDC_IC_LBL_SELECT,106,  43, 40, 12
    PUSHBUTTON "",       IDC_IC_BTN_SELECT,150,  42, 54, 14, BS_OWNERDRAW

    LTEXT      "Right",  IDC_IC_LBL_RIGHT,   4,  60, 40, 12
    PUSHBUTTON "",       IDC_IC_BTN_RIGHT,  48,  59, 54, 14, BS_OWNERDRAW
    LTEXT      "Start",  IDC_IC_LBL_START, 106,  60, 40, 12
    PUSHBUTTON "",       IDC_IC_BTN_START, 150,  59, 54, 14, BS_OWNERDRAW

    LTEXT      "Up R",   IDC_IC_LBL_UPRIGHT,    4,  77, 40, 12
    PUSHBUTTON "",       IDC_IC_BTN_UPRIGHT,  48,  76, 54, 14, BS_OWNERDRAW

    LTEXT      "R Down", IDC_IC_LBL_RIGHTDOWN, 4,  94, 40, 12
    PUSHBUTTON "",       IDC_IC_BTN_RIGHTDOWN,48,  93, 54, 14, BS_OWNERDRAW

    LTEXT      "Down L", IDC_IC_LBL_DOWNLEFT,  4, 111, 40, 12
    PUSHBUTTON "",       IDC_IC_BTN_DOWNLEFT, 48, 110, 54, 14, BS_OWNERDRAW

    LTEXT      "L Up",   IDC_IC_LBL_LEFTUP,    4, 128, 40, 12
    PUSHBUTTON "",       IDC_IC_BTN_LEFTUP,   48, 127, 54, 14, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",  IDOK,               80, 147, 50, 14, BS_OWNERDRAW
END

/* Volume/Rate/Bits/Quality "-/value/+" spinners - ported unchanged from
 * the sister ports' shared IDD_SOUNDCONFIG layout (see ce_audio.c). No
 * Cancel button: physical Back key (IDCANCEL) commits and closes, same
 * as OK. */
/* Every PUSHBUTTON carries BS_OWNERDRAW - see ce_bmpfont.c. */
IDD_SOUNDCONFIG DIALOG 0, 0, 190, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sound Config"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "Volume:",  IDC_SC_LBL_VOLUME,     8,  9, 44,  8
    PUSHBUTTON "-",        IDC_SC_VOLUME_MINUS,  53,  7, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "10",       IDC_SC_VOLUME_VALUE,  68,  6, 20, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_VOLUME_PLUS,   89,  7, 14, 12, BS_OWNERDRAW

    LTEXT      "Rate:",    IDC_SC_LBL_RATE,       8, 26, 30,  8
    PUSHBUTTON "-",        IDC_SC_RATE_MINUS,    53, 24, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "44100",    IDC_SC_RATE_VALUE,    68, 23, 60, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_RATE_PLUS,    129, 24, 14, 12, BS_OWNERDRAW

    LTEXT      "Bits:",    IDC_SC_LBL_BITS,       8, 42, 30, 10
    PUSHBUTTON "-",        IDC_SC_BITS_MINUS,    45, 41, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "16-bit",   IDC_SC_BITS_VALUE,    60, 40, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_BITS_PLUS,    124, 41, 14, 12, BS_OWNERDRAW

    LTEXT      "Quality:", IDC_SC_LBL_QUALITY,    8, 59, 34, 10
    PUSHBUTTON "-",        IDC_SC_QUALITY_MINUS, 45, 58, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "Smooth",   IDC_SC_QUALITY_VALUE, 60, 57, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_QUALITY_PLUS, 124, 58, 14, 12, BS_OWNERDRAW

    LTEXT      "Buffer:",  IDC_SC_LBL_BUFFER,     8, 76, 40,  8
    PUSHBUTTON "-",        IDC_SC_BUFFER_MINUS,  53, 75, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "64 KB",    IDC_SC_BUFFER_VALUE,  68, 74, 60, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_BUFFER_PLUS,  129, 75, 14, 12, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",    IDOK,                  70, 100, 50, 14, BS_OWNERDRAW
END

/* Scale (gnuboy's `scale` rcvar, 1..4), Color Filter (`colorfilter`
 * rcvar), Frame Skip (occupancy-driven, see ce_video.c), the English/
 * Japanese toggle and the debug-log switch - same layout template as Sample
 * Emulater's own IDD_VIDEOCONFIG, "No Sprite Limit"/core-option rows
 * replaced with gnuboy's own video rcvars. */
/* Every PUSHBUTTON/CHECKBOX carries BS_OWNERDRAW - see ce_bmpfont.c.
 * "Scale:" now has a real ID (IDC_VC_LBL_SCALE, ce_resource.h) instead
 * of "-1" so WM_PAINT's CeBmpFontPaintLabel() can find it, even though
 * it's never translated.
 * "Open Last Folder" was removed (user request) - it's now always on,
 * see ce_fileopen.c; Debug Log and OK moved up, height 132->118 (same
 * geometry as the sister PopSG's Video Config after the same removal). */
IDD_VIDEOCONFIG DIALOG 0, 0, 190, 118
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Video Config"
FONT 9, "Tahoma"
BEGIN
    LTEXT       "Scale:",       IDC_VC_LBL_SCALE,      8,  9, 30,  8
    PUSHBUTTON  "-",            IDC_VC_SCALE_MINUS,     45,  7, 14, 12, BS_OWNERDRAW
    PUSHBUTTON  "x1",           IDC_VC_SCALE_VALUE,     60,  6, 40, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",            IDC_VC_SCALE_PLUS,      101,  7, 14, 12, BS_OWNERDRAW

    CHECKBOX    "Color Filter", IDC_VC_COLORFILTER,      8, 24, 160, 12, BS_OWNERDRAW

    LTEXT       "Frame Skip:",  IDC_VC_LBL_FRAMESKIP,   8, 42,  90, 12
    PUSHBUTTON  "-",            IDC_VC_FRAMESKIP_DOWN, 100, 40,  14, 12, BS_OWNERDRAW
    PUSHBUTTON  "Off",          IDC_VC_FRAMESKIP_LABEL,116, 39,  26, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",            IDC_VC_FRAMESKIP_UP,   144, 40,  14, 12, BS_OWNERDRAW

    PUSHBUTTON  "-",              IDC_VC_LANG_MINUS,      34, 61,  14, 12, BS_OWNERDRAW
    PUSHBUTTON  "GAIKOKU-English", IDC_VC_JAPANESE,       50, 60,  90, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",              IDC_VC_LANG_PLUS,      142, 61,  14, 12, BS_OWNERDRAW

    CHECKBOX    "Enable Debug Log", IDC_VC_DEBUGLOG,      8, 76, 174, 12, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",  IDOK,                          70, 94, 50, 14, BS_OWNERDRAW
END

/* Custom ROM picker - replaces GetOpenFileNameW() (no Japanese folder/
 * file name support). Ported from the sister ports' shared IDD_FILEOPEN. */
/* IDC_FO_LIST carries LBS_OWNERDRAWFIXED (fixed row height - every row
 * is the same 16px-tall Shinonome glyph strip, so LBS_OWNERDRAWVARIABLE
 * isn't needed) so ROM/directory names with Japanese characters draw
 * with the bitmap font instead of tofu-ing under a TrueType face that
 * no longer exists. See ce_fileopen.c's WM_MEASUREITEM/WM_DRAWITEM.
 * LBS_HASSTRINGS is required alongside LBS_OWNERDRAWFIXED - without it
 * an owner-draw listbox does NOT retain the strings passed to
 * LB_ADDSTRING at all (real-hardware-confirmed: every row's rcItem/
 * selection highlight drew fine but LB_GETTEXT came back empty, so
 * every ROM/directory name silently failed to draw even though picking
 * one by touch still worked - the listbox was tracking selection by
 * index only, with no text ever stored). */
/* Resized to match the sister PopNES project's own IDD_FILEOPEN
 * exactly (190x104, listbox 178x64, OK at 70,86,50,14 - user request:
 * "PopNESのROMファイルダイアログにアップデートしたい...固定値6
 * ダイアログボックスのサイズもそのままコピー"). PopNES's own
 * comment on this template records that its 64-unit listbox height was
 * real-hardware-confirmed to show exactly 6 rows (CE_FILELIST_PAGE_SIZE
 * in ce_fileopen.c, also copied here) - see this project's own earlier
 * comment (now removed) for why the DLU-to-pixel relationship isn't a
 * simple 1:1 with ce_fileopen.c's WM_MEASUREITEM row height; that
 * mismatch is exactly why the row count is hardware-confirmed per
 * dialog size rather than computed. */
IDD_FILEOPEN DIALOG 0, 0, 190, 108
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select ROM"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",       IDC_FO_PATH, 6, 4, 178, 10
    /* 2026-09-27 (PopPCE と同じ変更): list 64 -> 68, dialog 104 -> 108,
     * OK 86 -> 90 - with the Galmuri14 font's 19px rows the 6th row came
     * out cut off on real hardware (PopPCE). */
    LISTBOX               IDC_FO_LIST, 6, 16, 178, 68, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK",   IDOK,        70, 90, 50, 14, BS_OWNERDRAW
END

/* Small generic message box (user request - the real MessageBoxW()
 * common dialog draws Japanese text with whatever CJK-capable system
 * font Windows CE can find, and this device has none any more since
 * session 21 replaced the separate TrueType font file with fonts built
 * into the binary - every Japanese character came back as tofu). This dialog instead
 * renders its text itself with the Shinonome bitmap font, the same way
 * every other piece of Japanese UI text in this port already does - see
 * ce_main.c's CeShowMsgBox()/MsgBoxDlgProc. Real-hardware-confirmed
 * fixed (tofu gone); narrowed to 2/3 of its original 200-unit width
 * (user request) once that was confirmed. IDC_MB_TEXT's rect is now too
 * narrow for this port's longer Japanese messages on one line at this
 * width, so MsgBoxDlgProc's WM_PAINT wraps onto a second line when
 * needed - the extra rect height below (36 vs the original single-line
 * 18) is for that second line. */
IDD_MSGBOX DIALOG 0, 0, 134, 70
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PopGB"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",     IDC_MB_TEXT, 8, 8, 118, 36
    DEFPUSHBUTTON "OK", IDOK,       42, 48, 50, 14, BS_OWNERDRAW
END

/* Yes/No confirmation (user request - Save State asks first). Same
 * self-drawn Shinonome-bitmap-font design as IDD_MSGBOX above; two
 * BS_OWNERDRAW buttons with custom IDs (IDC_CF_YES/IDC_CF_NO) drawn and
 * key-handled by ce_main.c's ConfirmDlgProc/ConfirmBtnCtrlProc. */
IDD_CONFIRM DIALOG 0, 0, 134, 70
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PopGB"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",      IDC_CF_TEXT, 8, 8, 118, 36
    DEFPUSHBUTTON "Yes", IDC_CF_YES, 18, 48, 45, 14, BS_OWNERDRAW
    PUSHBUTTON    "No",  IDC_CF_NO,  71, 48, 45, 14, BS_OWNERDRAW
END
